---
import type { Post, Language } from '../utils/routes';
import { categoryLabel, formatDate, postPath } from '../utils/routes';
import WalCommitDiagram from './WalCommitDiagram.astro';

interface Props {
  post?: Post;
  language: Language;
}

const { post, language } = Astro.props;
const labels = language === 'pt'
  ? { section: 'Post em destaque', figure: 'Fluxo de commit · PostgreSQL WAL', featured: 'Seleção editorial', emptyTitle: 'Nenhum post em destaque', emptyCopy: 'Quando um post for selecionado, ele aparecerá aqui com seus metadados originais.', read: 'Ler post', noTags: 'Sem tags' }
  : { section: 'Featured post', figure: 'Commit flow · PostgreSQL WAL', featured: 'Editorial selection', emptyTitle: 'No featured post yet', emptyCopy: 'A post will appear here once it has been selected for the editorial feature.', read: 'Read post', noTags: 'No tags' };
---

<section class="section featured-section wrap" aria-labelledby="featured-heading">
  <div class="section-heading section-heading-compact">
    <div>
      <p class="section-kicker">{labels.section}</p>
      <h2 id="featured-heading">{post ? post.data.title : labels.emptyTitle}</h2>
    </div>
    {post && <a href={postPath(post)}> {labels.read} <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="featured-panel">
    <figure class="featured-figure">
      <WalCommitDiagram language={language} />
      <figcaption><span class="diagram-pin" aria-hidden="true"></span>{labels.figure}</figcaption>
    </figure>
    <div class="featured-copy">
      {post ? (
        <>
          <div class="article-meta"><span>{categoryLabel(post.data.category, language)}</span><span>{formatDate(post.data.pubDate, language)}</span><span>{post.data.readingTime}</span></div>
          <h3><a href={postPath(post)}>{post.data.title}</a></h3>
          <p class="featured-summary">{post.data.description}</p>
          <div class="tag-list" aria-label={language === 'pt' ? 'Tags do post' : 'Post tags'}>
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <a class="inline-link" href={postPath(post)}>{labels.read}<span aria-hidden="true">↗</span></a>
        </>
      ) : (
        <>
          <p class="featured-placeholder-label">{labels.featured}</p>
          <h3>{labels.emptyTitle}</h3>
          <p class="featured-summary">{labels.emptyCopy}</p>
          <span class="tag-list tag-list-placeholder"><span>WAL</span><span>PostgreSQL</span><span>Commit</span></span>
        </>
      )}
    </div>
  </div>
</section>
