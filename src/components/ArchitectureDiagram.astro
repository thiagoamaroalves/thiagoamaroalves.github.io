---
interface Props {
  language?: 'pt' | 'en';
}

const { language = 'pt' } = Astro.props;
const labels = language === 'pt'
  ? { title: 'Fluxo de uma requisição entre aplicação, serviço e armazenamento', description: 'Uma requisição sai da aplicação, passa pelo serviço e chega ao armazenamento. A linha tracejada mostra o caminho da resposta.', application: 'APLICAÇÃO', service: 'SERVIÇO', storage: 'ARMAZENAMENTO', latency: 'LATÊNCIA', consistency: 'CONSISTÊNCIA', throughput: 'THROUGHPUT', availability: 'DISPONIBILIDADE', request: 'requisição', response: 'resposta' }
  : { title: 'A request flow between application, service, and storage', description: 'A request travels from the application through a service to storage. The dashed line shows the response path.', application: 'APPLICATION', service: 'SERVICE', storage: 'STORAGE', latency: 'LATENCY', consistency: 'CONSISTENCY', throughput: 'THROUGHPUT', availability: 'AVAILABILITY', request: 'request', response: 'response' };
---

<svg class="architecture-diagram" viewBox="0 0 620 430" role="img" aria-labelledby="architecture-title architecture-description">
  <title id="architecture-title">{labels.title}</title>
  <desc id="architecture-description">{labels.description}</desc>
  <defs>
    <pattern id="architecture-grid" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0V24" fill="none" stroke="#1F3A5F" stroke-opacity=".08" stroke-width=".7" />
    </pattern>
    <marker id="architecture-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
      <path d="M0 0L8 4L0 8" fill="none" stroke="#1F3A5F" stroke-width="1" />
    </marker>
  </defs>
  <rect width="620" height="430" fill="url(#architecture-grid)" />
  <g fill="none" stroke="#1F3A5F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M65 229H198" marker-end="url(#architecture-arrow)" />
    <path d="M378 229H510" marker-end="url(#architecture-arrow)" />
    <path d="M510 255H378" stroke-dasharray="4 6" marker-end="url(#architecture-arrow)" />
    <path d="M198 255H65" stroke-dasharray="4 6" marker-end="url(#architecture-arrow)" />
    <path d="M248 176l67-39 67 39v102l-67 39-67-39z" fill="#F2EFE8" />
    <path d="M248 176l67 40 67-40M315 216v101M248 278l67-40 67 40" />
    <path d="M99 190l35-20 35 20v62l-35 20-35-20z" fill="#FAF8F4" />
    <path d="M99 190l35 21 35-21M134 211v61M99 252l35-20 35 20" />
    <path d="M451 190l35-20 35 20v62l-35 20-35-20z" fill="#FAF8F4" />
    <path d="M451 190l35 21 35-21M486 211v61M451 252l35-20 35 20" />
    <path d="M99 325h70M248 347h134M451 325h70" stroke-opacity=".45" />
    <path d="M133 324v-31M315 346v-29M486 324v-31" stroke-dasharray="2 5" stroke-opacity=".7" />
  </g>
  <g fill="#161616" font-family="'IBM Plex Mono', monospace" font-size="10" letter-spacing="1.2" text-anchor="middle">
    <text x="134" y="305">{labels.application}</text>
    <text x="315" y="365">{labels.service}</text>
    <text x="486" y="305">{labels.storage}</text>
  </g>
  <g fill="#1F3A5F" font-family="'IBM Plex Mono', monospace" font-size="9" letter-spacing=".6">
    <text x="72" y="207">{labels.request}</text>
    <text x="414" y="207">{labels.request}</text>
    <text x="405" y="276">{labels.response}</text>
    <text x="71" y="276">{labels.response}</text>
  </g>
  <g fill="#5A5A57" font-family="'IBM Plex Mono', monospace" font-size="9" letter-spacing=".5">
    <text x="31" y="68">01 / {labels.latency}</text>
    <text x="426" y="68">02 / {labels.consistency}</text>
    <text x="31" y="390">03 / {labels.throughput}</text>
    <text x="426" y="390">04 / {labels.availability}</text>
  </g>
  <g fill="#1F3A5F">
    <circle cx="31" cy="64" r="2" /><circle cx="426" cy="64" r="2" />
    <circle cx="31" cy="386" r="2" /><circle cx="426" cy="386" r="2" />
  </g>
</svg>
