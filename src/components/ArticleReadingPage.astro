---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabel, formatDate, notePath, postPath, type Note, type Post } from '../utils/routes';

interface Props {
  entry: Post | Note;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isPost = entry.collection === 'posts';
const path = isPost ? postPath(entry as Post) : notePath(entry as Note);
const allPosts = await getCollection('posts');
const allNotes = await getCollection('notes');
const sourceEntries: (Post | Note)[] = isPost ? allPosts : allNotes;
const paired = entry.data.translationKey
  ? sourceEntries.find((candidate) => candidate.data.translationKey === entry.data.translationKey && candidate.data.language !== entry.data.language)
  : undefined;
const related = sourceEntries
  .filter((candidate) => candidate.id !== entry.id && candidate.data.language === entry.data.language)
  .map((candidate) => ({
    entry: candidate,
    score: candidate.data.tags.filter((tag) => entry.data.tags.some((current) => current.toLowerCase() === tag.toLowerCase())).length,
  }))
  .filter((candidate) => candidate.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ entry: candidate }) => ({
    title: candidate.data.title,
    href: candidate.collection === 'posts' ? postPath(candidate as Post) : notePath(candidate as Note),
  }));
const language = entry.data.language;
const portuguesePath = language === 'pt' ? path : paired ? (paired.collection === 'posts' ? postPath(paired as Post) : notePath(paired as Note)) : '/';
const englishPath = language === 'en' ? path : paired ? (paired.collection === 'posts' ? postPath(paired as Post) : notePath(paired as Note)) : '/en/';
const alternates = paired ? {
  pt: language === 'pt' ? path : portuguesePath,
  en: language === 'en' ? path : englishPath,
} : undefined;
const category = categoryLabel(entry.data.category, language);
const copy = language === 'pt'
  ? { back: isPost ? 'Voltar aos posts' : 'Voltar às notas', related: 'Leituras relacionadas', tags: 'Tags' }
  : { back: isPost ? 'Back to posts' : 'Back to notes', related: 'Related reading', tags: 'Tags' };
const archivePath = isPost ? (language === 'pt' ? '/artigos/' : '/en/writing/') : (language === 'pt' ? '/notas/' : '/en/notes/');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  language={language}
  canonicalPath={path}
  portuguesePath={portuguesePath}
  englishPath={englishPath}
  alternates={alternates}
  languageFallback={!paired}
>
  <article class="post-layout wrap">
    <div class="post-main">
      <header class="post-header">
        <div class="article-meta">
          <span>{category}</span>
          <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, language)}</time>
          <span>{entry.data.readingTime}</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="post-deck">{entry.data.description}</p>
        {entry.data.tags.length > 0 && (
          <div class="tag-list post-tags" aria-label={copy.tags}>
            {entry.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </header>
      <div class="post-content"><Content /></div>
      {related.length > 0 && (
        <section class="related-section" aria-labelledby="related-heading">
          <h2 id="related-heading">{copy.related}</h2>
          <div class="related-links">
            {related.map((item) => <a href={item.href}>{item.title}</a>)}
          </div>
        </section>
      )}
      <div class="post-end">
        <a class="text-link" href={archivePath}>{copy.back}</a>
        <a class="text-link" href={language === 'pt' ? '/' : '/en/'}>Thiago Alves</a>
      </div>
    </div>
  </article>
</BaseLayout>
