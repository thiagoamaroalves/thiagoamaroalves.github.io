---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <section class="page-intro wrap">
    <p class="eyebrow">404 — Nothing at this address</p>
    <h1>That path changed.</h1>
    <p>The page may have moved, or the address may be incomplete. Head back to the writing archive and take another route.</p>
    <a class="button" style="margin-top: 24px" href="/writing/">Browse the writing <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
