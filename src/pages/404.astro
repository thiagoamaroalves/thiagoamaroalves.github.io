---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="A página solicitada não foi encontrada." language="pt">
  <section class="page-intro wrap">
    <p class="eyebrow">404 · página não encontrada</p>
    <h1>Este caminho não existe.</h1>
    <p>O endereço pode ter mudado ou estar incompleto. Volte à página inicial ou explore os posts publicados.</p>
    <div class="hero-actions">
      <a class="button" href="/">Página inicial</a>
      <a class="text-link" href="/artigos/">Explorar posts</a>
    </div>
  </section>
</BaseLayout>
