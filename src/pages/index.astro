---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(date);
---

<BaseLayout>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow">A notebook on building software</p>
      <h1>Make systems easier to <em>change.</em></h1>
      <p class="hero-copy">
        Ideas and trade-offs for building software that evolves. Notes on <strong>architecture</strong>,
        engineering practice, programming, and practical AI.
      </p>
      <div class="hero-actions">
        <a class="button" href="/writing/">Explore the writing <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/about/">About this blog</a>
      </div>
    </div>
    <div class="blueprint" aria-label="A diagram showing how clear boundaries help a system absorb change">
      <div class="blueprint-top">
        <span class="diagram-label">A system in motion</span>
        <span class="diagram-number">FIG. 01</span>
      </div>
      <div class="diagram" aria-hidden="true">
        <svg viewBox="0 0 420 225" role="img">
          <text x="15" y="34" class="tiny">CHANGE ARRIVES</text>
          <text x="301" y="34" class="tiny">SYSTEM RESPONSE</text>
          <path d="M28 112H100M164 112H240M304 112H385" />
          <path class="route" d="M28 112H112M164 112H250M304 112H385" />
          <circle cx="35" cy="112" r="7" />
          <rect x="100" y="73" width="66" height="78" rx="1" />
          <rect x="240" y="73" width="64" height="78" rx="1" />
          <circle cx="385" cy="112" r="7" />
          <text x="109" y="105">BOUNDARY</text>
          <text x="116" y="123" class="tiny">clear contract</text>
          <text x="249" y="105">CORE</text>
          <text x="249" y="123" class="tiny">stable rules</text>
          <text x="22" y="143" class="tiny">new need</text>
          <text x="348" y="143" class="tiny">small change</text>
          <path d="M133 73V49M272 151V176" />
          <text x="98" y="43" class="tiny">CONTAIN</text>
          <text x="242" y="194" class="tiny">PRESERVE</text>
        </svg>
      </div>
      <div class="blueprint-bottom"><span>A space for questions that change the work</span><b>FIRST / 01</b></div>
    </div>
  </section>

  <section class="ticker" aria-label="Topics">
    <div class="ticker-inner wrap">
      <span class="ticker-label">Explore by theme</span>
      <div class="topic-pills">
        <span class="topic-pill">Architecture</span>
        <span class="topic-pill">Engineering</span>
        <span class="topic-pill">Programming</span>
        <span class="topic-pill">Applied AI</span>
      </div>
    </div>
  </section>

  <section class="section wrap" id="writing">
    <div class="section-heading">
      <div>
        <p class="section-kicker">01 — Start here</p>
        <h2>Ideas worth keeping close.</h2>
      </div>
      <a href="/writing/">All writing <span aria-hidden="true">↗</span></a>
    </div>
    {featured ? (
      <div class="featured-grid">
        <article class="featured-main">
          <div class="article-meta">
            {featured.data.category}<span class="meta-dot">•</span>{formatDate(featured.data.pubDate)}
          </div>
          <h3><a href={`/writing/${featured.id}/`}>{featured.data.title}</a></h3>
          <p>{featured.data.description}</p>
          <a class="read-link" href={`/writing/${featured.id}/`}>Read the essay <span aria-hidden="true">→</span></a>
        </article>
        <aside class="featured-side">
          <div class="side-note">
            <span class="note-index">A working principle</span>
            <p>Good design makes the next useful change easier to make.</p>
            <small>Architecture · Practice · Code</small>
          </div>
          <div class="side-caption">No silver bullets. Just clearer decisions, smaller feedback loops, and ideas tested against the work.</div>
        </aside>
      </div>
    ) : (
      <div class="empty-state">
        <span class="note-index">First entry</span>
        <h3>Let’s shape the first essay together.</h3>
        <p>Bring a question from your work or learning. We’ll build the argument, examples, and takeaway around it.</p>
        <a class="read-link" href="/about/">What this notebook is for <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  {latest.length > 0 && (
    <section class="section wrap" style="padding-top: 0">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 — Recently added</p>
          <h2>More from the notebook.</h2>
        </div>
      </div>
      <div class="article-list">
        {latest.map((post) => (
          <article class="article-row">
            <span class="row-category">{post.data.category}</span>
            <div>
              <h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <time class="row-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="closing-band">
    <div class="closing-inner wrap">
      <div>
        <p class="section-kicker">Keep exploring</p>
        <h2>Technical work gets better when we can explain why it works.</h2>
      </div>
      <a class="button" href="/about/">The idea behind the blog <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
